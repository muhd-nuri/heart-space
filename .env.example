# PostgreSQL — local dev or Neon/Supabase URL
DATABASE_URL="postgresql://user:password@localhost:5432/heartspace"

# Better Auth
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Stripe — payment provider
# Get keys from https://dashboard.stripe.com/apikeys
# For local webhook testing: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_SECRET_KEY=""             # sk_test_… or sk_live_…
STRIPE_WEBHOOK_SECRET=""         # whsec_… (printed by `stripe listen`, or copied from the dashboard endpoint)

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@heartspace.my"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Analytics — leave empty to disable injection
NEXT_PUBLIC_GA_ID=""           # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""    # e.g. 1234567890123456

# Resend
RESEND_TEAM_INBOX="hello@heartspace.my"

# UploadThing (image uploads for admin) — get from https://uploadthing.com
UPLOADTHING_TOKEN=""
